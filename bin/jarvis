#!/usr/bin/env node
/* Jarvis CLI.
 *
 *   jarvis                  start the HUD
 *   jarvis setup            first-run wizard
 *   jarvis collect [--fetch]refresh vitals
 *   jarvis voice <cmd>      kokoro setup: install | start | stop | status
 *   jarvis ytdlp <cmd>      bundle a known-good yt-dlp: install | status | remove
 *   jarvis mcp              list MCP servers: mcp allow <name> | deny <name>
 *   jarvis index            rebuild index.md in every documents folder
 *   jarvis transcript <url> transcript via captions, whisper only if needed
 *   jarvis agents           list agents and their schedules\n *   jarvis agents check     preflight every agent before trusting a schedule
 *   jarvis agent <name>     run one agent now, in the foreground
 *   jarvis agents install   put enabled agents on the OS scheduler
 *   jarvis agents uninstall remove them
 *   jarvis doctor           check what is actually wired up
 */
const path = require("path");
const fs = require("fs");
const { spawn, execFileSync } = require("child_process");

const ROOT = path.join(__dirname, "..");
const { load } = require(path.join(ROOT, "lib", "config"));

const [, , cmd = "start", ...rest] = process.argv;

const has = (c) => {
  try { execFileSync("which", [c], { stdio: "ignore" }); return true; } catch { return false; }
};

/* Checking the version is not enough.
 *
 * A stale yt-dlp still reports a version, still answers --version, and then
 * fails every real request with "The page needs to be reloaded" while the
 * dashboard quietly fills with zeroes. Worse, an old copy earlier on PATH can
 * shadow a current one, so the fix looks applied and is not. So: actually
 * fetch something and see if data comes back.
 */
function ytdlpStatus() {
  // same resolution order as scripts/ytdlp_util.py: bundled copy wins
  const bundled = path.join(ROOT, "bin", "yt-dlp");
  let exe = null;
  try { fs.accessSync(bundled, fs.constants.X_OK); exe = bundled; } catch {}
  if (!exe && has("yt-dlp")) exe = "yt-dlp";
  if (!exe) {
    return "no    fix: jarvis ytdlp install   (bundles its own python, no brew needed)";
  }
  const where = exe === bundled ? "bundled" : "PATH";

  let version = "unknown";
  try {
    version = execFileSync(exe, ["--version"], {
      encoding: "utf8",
      stdio: ["ignore", "pipe", "ignore"], // it warns on stderr; not our problem
    }).trim();
  } catch {}

  // a second copy earlier on PATH is the trap that hides every other fix
  let shadowed = "";
  try {
    const all = execFileSync("which", ["-a", "yt-dlp"], { encoding: "utf8" })
      .trim().split("\n").filter(Boolean);
    if (all.length > 1) {
      shadowed = `\n                       ${all.length} copies on PATH, using ${all[0]}` +
                 `\n                       shadowed: ${all.slice(1).join(", ")}`;
    }
  } catch {}

  // Two steps: search still works on a stale yt-dlp, it is the per-video fetch
  // that dies. And no hardcoded video id, because they get taken down - the
  // first version of this check tested a video that no longer exists and
  // reported a perfectly good binary as broken.
  let works = false;
  try {
    const q = { encoding: "utf8", stdio: ["ignore", "pipe", "ignore"], timeout: 45000 };
    const id = execFileSync(exe,
      ["ytsearch1:claude code", "--flat-playlist", "--print", "%(id)s", "--no-warnings"], q)
      .trim().split("\n")[0];
    if (id) {
      const views = execFileSync(exe,
        [`https://www.youtube.com/watch?v=${id}`, "--skip-download",
         "--print", "%(view_count)s", "--no-warnings"], q).trim();
      works = /^\d+$/.test(views);
    }
  } catch {}

  if (!works) {
    return `BROKEN  ${version} (${where}) answers --version but cannot fetch.` +
           `\n                       fix: jarvis ytdlp install` + shadowed;
  }
  return `yes   ${version} (${where}), fetch verified${shadowed}`;
}

function run(file, args = [], opts = {}) {
  const child = spawn(process.execPath, [file, ...args], { stdio: "inherit", cwd: ROOT, ...opts });
  child.on("close", (code) => process.exit(code || 0));
}

function python(file, args = []) {
  const child = spawn("python3", [file, ...args], { stdio: "inherit", cwd: ROOT });
  child.on("close", (code) => process.exit(code || 0));
}

async function main() {
  switch (cmd) {
    case "start":
      return run(path.join(ROOT, "server.js"));

    case "setup":
      return run(path.join(ROOT, "scripts", "setup.js"));

    case "collect":
      return python(path.join(ROOT, "scripts", "collect.py"), rest);

    case "voice": {
      const child = spawn("bash", [path.join(ROOT, "scripts", "voice.sh"), ...rest], {
        stdio: "inherit", cwd: ROOT,
      });
      child.on("close", (code) => process.exit(code || 0));
      return;
    }

    case "ytdlp": {
      const child = spawn("bash", [path.join(ROOT, "scripts", "ytdlp.sh"), ...rest], {
        stdio: "inherit", cwd: ROOT,
      });
      child.on("close", (code) => process.exit(code || 0));
      return;
    }

    /* MCP servers are the one integration Jarvis inherits rather than owns.
     * The CLI has to make the state visible, because the failure when a server
     * is connected but not allowed is a local rejection that reads like an
     * outage. */
    case "mcp": {
      const cfg = load();
      const mcp = require(path.join(ROOT, "lib", "mcp"));
      const { save } = require(path.join(ROOT, "lib", "config"));
      const [sub, ...names] = rest;

      if (!sub || sub === "list") {
        const { servers, error } = await mcp.status(cfg);
        if (error) {
          // never render a failed lookup as "you have none"
          console.log(`\n  Could not read your MCP servers: ${error}\n`);
          return;
        }
        if (!servers.length) {
          console.log("\n  No MCP servers configured for the `claude` CLI.");
          console.log("  Add one with: claude mcp add <name> <url>\n");
          return;
        }
        console.log("");
        for (const s of servers) {
          const state = s.enabled ? "ON " : "off";
          const health = s.connected ? "" : `  (${s.status})`;
          console.log(`  ${state}  ${s.name.padEnd(26)} ${s.prefix}${health}`);
        }
        const off = servers.filter((s) => !s.enabled).length;
        if (off) {
          console.log(`\n  ${off} server(s) connected but not available to Jarvis.`);
          console.log(`  Turn one on:  jarvis mcp allow <name>`);
          console.log(`  Or all:       jarvis mcp allow all\n`);
        } else {
          console.log(`\n  All ${servers.length} available to Jarvis.\n`);
        }
        return;
      }

      if (sub === "allow" || sub === "deny") {
        if (!names.length) {
          console.error(`usage: jarvis mcp ${sub} <name> [name...]   (or "all")`);
          process.exit(1);
        }
        const { servers, error } = await mcp.discover();
        if (error && names[0] !== "all") {
          console.error(`  Could not read your MCP servers: ${error}`);
          process.exit(1);
        }
        if (names[0] === "all") {
          save({ chat: { mcp_servers: sub === "allow" ? "all" : [] } });
          console.log(sub === "allow"
            ? `  all MCP servers are now available to Jarvis`
            : `  no MCP servers are available to Jarvis`);
          return;
        }
        const current = mcp.enabledNames(cfg);
        // "all" is not a list, so turning one off has to expand it first
        let list = current === "all" ? servers.map((s) => s.name) : [...current];
        for (const n of names) {
          const hit = servers.find((s) => s.name.toLowerCase() === n.toLowerCase());
          if (!hit) {
            console.error(`  no such MCP server: ${n}`);
            console.error(`  known: ${servers.map((s) => s.name).join(", ") || "none"}`);
            process.exit(1);
          }
          const has = list.some((x) => String(x).toLowerCase() === hit.name.toLowerCase());
          if (sub === "allow" && !has) list.push(hit.name);
          if (sub === "deny") list = list.filter((x) => String(x).toLowerCase() !== hit.name.toLowerCase());
        }
        save({ chat: { mcp_servers: list } });
        console.log(`  ${sub === "allow" ? "allowed" : "denied"}: ${names.join(", ")}`);
        console.log(`  Jarvis can now use: ${list.length ? list.join(", ") : "no MCP servers"}`);
        console.log(`  Restart the server for it to take effect.`);
        return;
      }

      console.error("usage: jarvis mcp [list | allow <name> | deny <name>]");
      process.exit(1);
    }

    case "index":
      return python(path.join(ROOT, "scripts", "index.py"), rest);

    case "transcript":
      if (!rest.length) {
        console.error("usage: jarvis transcript <youtube-url-or-id> [--out FILE]");
        process.exit(1);
      }
      return python(path.join(ROOT, "scripts", "transcript.py"), rest);

    case "agent": {
      const cfg = load();
      const agents = require(path.join(ROOT, "lib", "agents"));
      const name = rest[0];
      if (!name) {
        console.error("usage: jarvis agent <name>");
        process.exit(1);
      }
      const res = await agents.run(cfg, name, { onLog: (l) => console.log(l) });
      if (res.skipped) console.log(`skipped: missing config for ${res.missing.join(", ")}`);
      return;
    }

    case "agents": {
      const cfg = load();
      const agents = require(path.join(ROOT, "lib", "agents"));
      const schedule = require(path.join(ROOT, "lib", "schedule"));
      const all = agents.list(cfg);
      const sub = rest[0];

      if (sub === "install") {
        const { platform, installed } = await schedule.install(cfg, all);
        if (!installed.length) {
          console.log("nothing to install - no enabled agents have a schedule");
          console.log(`enable some in config.json under agents.enabled`);
          return;
        }
        console.log(`installed on ${platform === "darwin" ? "launchd" : "cron"}:`);
        installed.forEach((i) => console.log(`  ${i}`));
        return;
      }
      if (sub === "check") {
        let bad = 0;
        for (const r of agents.check(cfg)) {
          const tag = r.problems.length ? "FAIL" : "ok  ";
          console.log(`  ${tag} ${r.name.padEnd(15)} ${r.enabled ? "" : "(disabled)"}`);
          r.problems.forEach((p2) => { bad++; console.log(`         ! ${p2}`); });
          r.notes.forEach((n) => console.log(`         - ${n}`));
        }
        console.log(bad ? `\n  ${bad} problem(s)` : `\n  all agents check out`);
        process.exit(bad ? 1 : 0);
      }
      if (sub === "uninstall") {
        const { removed } = await schedule.uninstall(cfg, all);
        console.log(removed.length ? `removed: ${removed.join(", ")}` : "nothing installed");
        return;
      }

      for (const a of all) {
        const unmet = agents.unmetRequirements(a, cfg);
        const state = !a.enabled ? "off" : unmet.length ? `needs ${unmet.join(",")}` : "on";
        let last = "never run";
        try { last = new Date(fs.statSync(a.log).mtimeMs).toLocaleString(); } catch {}
        console.log(`  ${a.name.padEnd(15)} ${String(a.schedule || "on demand").padEnd(14)} ${state.padEnd(16)} ${last}`);
      }
      console.log(`\n  run one now:  jarvis agent <name>`);
      console.log(`  schedule all: jarvis agents install`);
      return;
    }

    case "doctor": {
      const cfg = load();
      const tts = require(path.join(ROOT, "lib", "tts"));
      const stt = require(path.join(ROOT, "lib", "stt"));
      const voice = await tts.status(cfg);
      const mic = await stt.status(cfg);
      const ok = (b) => (b ? "yes" : "no");

      console.log(`\n  CONFIG`);
      console.log(`    config.json        ${ok(cfg.configured)}${cfg.configured ? "" : "   <- run 'jarvis setup'"}`);
      console.log(`    owner              ${cfg.profile.owner || "(unset)"}`);
      console.log(`    youtube            ${cfg.profile.channels.youtube || "(unset)"}`);
      console.log(`    persona override   ${ok(fs.existsSync(path.join(ROOT, "PERSONA.md")))}`);

      const brain = require(path.join(ROOT, "lib", "brain"));
      const brainStatus = await brain.status(cfg);
      console.log(`\n  BRAIN (${cfg.brain.chain.join(" -> ")})`);
      console.log(`    claude code        ${ok(brainStatus.providers["claude-code"])}`);
      console.log(`    openai-compatible  ${ok(brainStatus.providers.openai)}   ${cfg.brain.openai.base_url}`);
      console.log(`    active             ${brainStatus.active || "NONE - chat will not work"}`);

      console.log(`\n  TOOLS`);
      console.log(`    yt-dlp             ${ytdlpStatus()}`);
      console.log(`    ffmpeg             ${ok(mic.ffmpeg)}   (needed for local whisper)`);

      console.log(`\n  VOICE OUT (first available wins: ${cfg.voice.chain.join(" -> ")})`);
      for (const [k, v] of Object.entries(voice)) console.log(`    ${k.padEnd(18)} ${ok(v)}`);

      console.log(`\n  VOICE IN (${cfg.stt.chain.join(" -> ")})`);
      // Everything below answers "could this transcribe". This one answers
      // "is there anything to transcribe", which is what actually bites: a
      // Mac Studio has no built-in mic, so the rest can all be ready while
      // the browser fails with NotFoundError.
      console.log(`    microphone         ${
        mic.input === null ? "unknown" :
        mic.input ? "yes" : "NONE - no audio input device on this machine"}`);
      console.log(`    local whisper      ${ok(mic.local)}`);
      console.log(`    openai whisper     ${ok(mic.openai)}`);
      console.log(`    browser fallback   yes   (chrome only, audio leaves this machine)`);

      console.log(`\n  SERVER`);
      const loopback = ["127.0.0.1", "localhost", "::1"].includes(cfg.server.host);
      console.log(`    bind               ${cfg.server.host}:${cfg.server.port}`);
      console.log(`    token              ${cfg.server.token ? "set" : "not set"}`);
      if (!loopback && !cfg.server.token)
        console.log(`    WARNING            exposed without a token - the server will refuse to start`);

      /* A connected-but-not-allowed server fails as a local rejection, which
       * reads like the service being down. Showing both states is the
       * difference between a five second fix and debugging the wrong layer. */
      const mcpLib = require(path.join(ROOT, "lib", "mcp"));
      const { servers, error: mcpErr } =
        await mcpLib.status(cfg).catch((e) => ({ servers: [], error: e.message }));
      if (mcpErr) {
        console.log(`\n  MCP SERVERS        could not check: ${mcpErr}`);
      } else if (servers.length) {
        const on = servers.filter((s) => s.enabled);
        console.log(`\n  MCP SERVERS        ${on.length} of ${servers.length} available to Jarvis`);
        for (const s of servers) {
          const why = !s.connected ? `   (${s.status})` : "";
          console.log(`    ${s.name.padEnd(24)} ${s.enabled ? "yes" : "no "}${why}`);
        }
        if (on.length < servers.length)
          console.log(`    fix                jarvis mcp allow <name>`);
      } else {
        console.log(`\n  MCP SERVERS        none configured for the claude CLI`);
      }

      const agents = require(path.join(ROOT, "lib", "agents"));
      const enabled = agents.list(cfg).filter((a) => a.enabled);
      console.log(`\n  AGENTS             ${enabled.length} enabled: ${enabled.map((a) => a.name).join(", ") || "none"}\n`);
      return;
    }

    case "--help":
    case "-h":
    case "help":
      console.log(fs.readFileSync(__filename, "utf8").split("*/")[0].replace(/^#![^\n]*\n/, "").replace(/\/\* ?/g, "").replace(/^ \* ?/gm, ""));
      return;

    default:
      console.error(`unknown command: ${cmd}\ntry: jarvis help`);
      process.exit(1);
  }
}

main().catch((e) => {
  console.error(e.message || e);
  process.exit(1);
});
