#!/usr/bin/env node
/* Jarvis CLI.
 *
 *   jarvis                  start the HUD
 *   jarvis setup            first-run wizard
 *   jarvis collect [--fetch]refresh vitals
 *   jarvis voice <cmd>      kokoro setup: install | start | stop | status
 *   jarvis ytdlp <cmd>      bundle a known-good yt-dlp: install | status | remove
 *   jarvis mcp              list MCP servers: mcp allow <name> | deny <name>
 *   jarvis index            rebuild index.md in every documents folder
 *   jarvis transcript <url> transcript via captions, whisper only if needed
 *   jarvis agents           list agents and their schedules
 *   jarvis agents check     preflight every agent before trusting a schedule
 *   jarvis agent <name>     run one agent now, in the foreground
 *   jarvis agents install   put enabled agents on the OS scheduler
 *   jarvis agents uninstall remove them
 *   jarvis connect          guided setup for chat delivery: pick a platform and prove it
 *   jarvis connect <plat>   skip the menu: ntfy | discord | slack | telegram | webhook
 *   jarvis connect --status what is hooked up right now: channels, secrets, inbox, agents
 *   jarvis notify           which chat channels and providers are configured
 *   jarvis notify test [x]  really post a one-line ping: x is a channel name
 *                           from notify.channels or a provider name
 *   jarvis notify telegram-id  list the chats that messaged your bot, with ids
 *   jarvis inbox            talk to Jarvis from your phone: is the Telegram bridge running
 *   jarvis inbox start      poll Telegram (outbound only) and answer allowed chats
 *   jarvis inbox stop
 *   jarvis inbox install    keep the bridge running across reboots (launchd/cron)
 *   jarvis inbox uninstall
 *   jarvis memory           print what the operator told Jarvis to keep
 *   jarvis memory add "<text>"       add a line (same as "remember that" in chat)
 *   jarvis memory forget <needle>    drop every line containing the words
 *   jarvis experiments      the experiments ledger: open, overdue, closed with verdicts
 *   jarvis doctor           check what is actually wired up
 */

/* Runs before anything is required, and in ES5 only, so an old Node reaches
 * this message instead of dying on a SyntaxError inside a module it could not
 * parse. Ubuntu 22.04 and Debian 11 still ship Node 12 as `nodejs`, which is
 * how most people arrive here. `help` prints the block above, so this one has
 * to stay below it. */
var MIN_NODE = parseInt(String((require("../package.json").engines || {}).node || "18").replace(/[^0-9]/g, ""), 10) || 18;
if (parseInt(process.versions.node.split(".")[0], 10) < MIN_NODE) {
  console.error(
    "\n  Jarvis needs Node " + MIN_NODE + " or newer. This is Node " + process.versions.node + ".\n" +
    "\n  If you installed it with `apt install nodejs` on Ubuntu 22.04 or Debian 11," +
    "\n  that is Node 12. Install a current one instead:\n" +
    "\n    curl -fsSL https://deb.nodesource.com/setup_22.x | sudo -E bash -" +
    "\n    sudo apt install -y nodejs\n" +
    "\n  or, without sudo:  nvm install --lts\n"
  );
  process.exit(1);
}
const path = require("path");
const fs = require("fs");
const { spawn, execFileSync } = require("child_process");

const ROOT = path.join(__dirname, "..");
const { load } = require(path.join(ROOT, "lib", "config"));
const { readJson: readJsonFile } = require(path.join(ROOT, "lib", "util"));

const [, , cmd = "start", ...rest] = process.argv;

const has = (c) => {
  try { execFileSync("which", [c], { stdio: "ignore" }); return true; } catch { return false; }
};

/* Checking the version is not enough.
 *
 * A stale yt-dlp still reports a version, still answers --version, and then
 * fails every real request with "The page needs to be reloaded" while the
 * dashboard quietly fills with zeroes. Worse, an old copy earlier on PATH can
 * shadow a current one, so the fix looks applied and is not. So: actually
 * fetch something and see if data comes back.
 */
function ytdlpStatus() {
  // same resolution order as scripts/ytdlp_util.py: bundled copy wins
  const bundled = path.join(ROOT, "bin", "yt-dlp");
  let exe = null;
  try { fs.accessSync(bundled, fs.constants.X_OK); exe = bundled; } catch {}
  if (!exe && has("yt-dlp")) exe = "yt-dlp";
  if (!exe) {
    return "no    fix: jarvis ytdlp install   (bundles its own python, no brew needed)";
  }
  const where = exe === bundled ? "bundled" : "PATH";

  let version = "unknown";
  try {
    version = execFileSync(exe, ["--version"], {
      encoding: "utf8",
      stdio: ["ignore", "pipe", "ignore"], // it warns on stderr; not our problem
    }).trim();
  } catch {}

  // a second copy earlier on PATH is the trap that hides every other fix
  let shadowed = "";
  try {
    const all = execFileSync("which", ["-a", "yt-dlp"], { encoding: "utf8" })
      .trim().split("\n").filter(Boolean);
    if (all.length > 1) {
      shadowed = `\n                       ${all.length} copies on PATH, using ${all[0]}` +
                 `\n                       shadowed: ${all.slice(1).join(", ")}`;
    }
  } catch {}

  // Two steps: search still works on a stale yt-dlp, it is the per-video fetch
  // that dies. And no hardcoded video id, because they get taken down - the
  // first version of this check tested a video that no longer exists and
  // reported a perfectly good binary as broken.
  let works = false;
  try {
    const q = { encoding: "utf8", stdio: ["ignore", "pipe", "ignore"], timeout: 45000 };
    const id = execFileSync(exe,
      ["ytsearch1:claude code", "--flat-playlist", "--print", "%(id)s", "--no-warnings"], q)
      .trim().split("\n")[0];
    if (id) {
      const views = execFileSync(exe,
        [`https://www.youtube.com/watch?v=${id}`, "--skip-download",
         "--print", "%(view_count)s", "--no-warnings"], q).trim();
      works = /^\d+$/.test(views);
    }
  } catch {}

  if (!works) {
    return `BROKEN  ${version} (${where}) answers --version but cannot fetch.` +
           `\n                       fix: jarvis ytdlp install` + shadowed;
  }
  return `yes   ${version} (${where}), fetch verified${shadowed}`;
}


/* Will the scheduled times actually happen?
 *
 * launchd and cron both fire against wall-clock time on a machine that is
 * awake. Neither wakes a sleeping one. macOS at least replays what it missed,
 * a few hours late and trickling in; cron simply skips a missed job forever.
 * Either way "07:00" in the agent list is a promise the OS may not keep, and
 * silently running late is the kind of thing someone discovers three days in
 * when a report they expected never appeared. So say it up front.
 */
function sleepAdvice() {
  if (process.platform !== "darwin") {
    return {
      warn: true,
      lines: [
        "cron does not run jobs missed while the machine was off or asleep.",
        "If this machine sleeps, schedule a wake, or keep it awake overnight.",
      ],
    };
  }
  let sleeps = null, hasWake = false;
  try {
    const out = execFileSync("pmset", ["-g", "custom"], { encoding: "utf8" });
    // the idle-sleep minutes for the active power source; 0 means never
    const m = out.match(/^\s*sleep\s+(\d+)/m);
    if (m) sleeps = Number(m[1]);
  } catch {}
  try {
    const sched = execFileSync("pmset", ["-g", "sched"], { encoding: "utf8" });
    // Only a REPEATING wake counts. The "Scheduled power events" list is full
    // of transient one-offs the system books for itself (calendar refresh,
    // analytics), and matching those reported this machine as fine on a day we
    // had just watched every agent run three hours late.
    const rep = sched.split(/Repeating power events:/i)[1];
    hasWake = Boolean(rep && /wake|poweron/i.test(rep));
  } catch {}

  if (sleeps === 0) return { warn: false, lines: ["this machine does not sleep, so agents run on time"] };
  if (hasWake) return { warn: false, lines: ["a scheduled wake exists, so agents should run close to their times"] };
  return {
    warn: true,
    lines: [
      `this Mac sleeps after ${sleeps === null ? "an idle period" : sleeps + " min"} and has no scheduled wake,`,
      "so agents run whenever it next wakes, typically hours late. macOS does",
      "replay what it missed, so nothing is lost, it is just not on time.",
      "To have them run at the scheduled times, either:",
      "  sudo pmset repeat wakeorpoweron MTWRFSU 05:55:00   # wake just before",
      "  sudo pmset -a sleep 0                              # or never sleep",
    ],
  };
}

/* What offset do the agent logs ACTUALLY show, scheduled time vs run time?
 *
 * Written because the check above looked at the schedule, said "ok", and was
 * wrong on a day every agent ran exactly three hours late. Configuration says
 * what should happen; the logs say what did. Only the logs can catch a clock
 * that is lying, and by the time you are asking, that is the question.
 *
 * A run started by hand shows up here as noise, so an offset only counts when
 * at least two different agents show the same one. Nobody manually runs two
 * agents the same distance from their schedules.
 */
function observedOffset(cfg) {
  let agents = [];
  try {
    agents = require(path.join(ROOT, "lib", "agents")).list(cfg).filter((a) => a.enabled && a.schedule);
  } catch { return { offset: null, runs: 0 }; }

  let runs = 0;
  const byOffset = new Map(); // rounded minutes -> Set of agent names
  for (const a of agents) {
    const m = String(a.schedule).trim().split(/\s+/);
    const min = Number(m[0]), hr = Number(m[1]);
    if (!Number.isInteger(min) || !Number.isInteger(hr)) continue; // wildcards, steps
    const want = hr * 60 + min;

    let log = "";
    try { log = fs.readFileSync(a.log, "utf8"); } catch { continue; }
    for (const line of log.split("\n").slice(-400)) {
      const t = line.match(/^=== \S+ \d{4}-\d{2}-\d{2} (\d{2}):(\d{2}) ===/);
      if (!t) continue;
      runs++;
      const got = Number(t[1]) * 60 + Number(t[2]);
      // wrap into -12h..+12h so a job at 21:00 running at 00:00 reads +3h,
      // not -21h, which is the same event described uselessly
      let d = got - want;
      if (d > 720) d -= 1440;
      if (d < -720) d += 1440;
      if (Math.abs(d) < 20) continue; // ran close enough to on time
      const key = Math.round(d / 15) * 15;
      if (!byOffset.has(key)) byOffset.set(key, new Set());
      byOffset.get(key).add(a.name);
    }
  }
  let best = null;
  for (const [mins, names] of byOffset)
    if (names.size >= 2 && (!best || names.size > best.names.size))
      best = { mins, names: [...names] };
  return { offset: best, runs };
}

/* launchd reads the timezone once, when it starts, and never again.
 *
 * Change the timezone after boot and every StartCalendarInterval keeps firing
 * in the old one until you restart. It is silent, it survives reloading the
 * job, and it looks exactly like a machine that sleeps - which is what it got
 * misdiagnosed as here, for a day, complete with pmset advice that would not
 * have helped.
 */
function timezoneAdvice(cfg) {
  if (process.platform !== "darwin") return { warn: false, lines: [] };

  let bootMs = null, tzMs = null;
  try {
    const m = execFileSync("sysctl", ["-n", "kern.boottime"], { encoding: "utf8" }).match(/sec\s*=\s*(\d+)/);
    if (m) bootMs = Number(m[1]) * 1000;
  } catch {}
  try { tzMs = fs.lstatSync("/etc/localtime").mtimeMs; } catch {}

  const changedAfterBoot = bootMs && tzMs && tzMs > bootMs;
  const { offset, runs } = observedOffset(cfg);

  if (offset) {
    const h = (offset.mins / 60).toFixed(offset.mins % 60 ? 2 : 0);
    return {
      warn: true,
      confirmed: true,
      lines: [
        `agents are running ${offset.mins > 0 ? "+" : ""}${h}h off their schedule`,
        `  (seen in: ${offset.names.join(", ")})`,
        ...(changedAfterBoot
          ? ["the timezone was changed after this machine booted, and launchd",
             "still holds the old one. Reloading a job does not clear it.",
             "Restart the machine."]
          : ["check the timezone, and whether this machine sleeps."]),
      ],
    };
  }
  // The logs are the better witness. If agents have been running and none of
  // them drifted, the clock is fine whatever the file timestamps suggest -
  // launchd may well have been restarted since. Only warn on the timestamps
  // when there is no run history to contradict them.
  if (changedAfterBoot && runs === 0)
    return {
      warn: true,
      lines: [
        "the timezone was changed after boot. launchd caches it at start, so",
        "scheduled agents may fire in the OLD zone until you restart. Nothing",
        "has run yet, so there is no evidence either way.",
      ],
    };
  return { warn: false, lines: [] };
}

function run(file, args = [], opts = {}) {
  const child = spawn(process.execPath, [file, ...args], { stdio: "inherit", cwd: ROOT, ...opts });
  child.on("close", (code) => process.exit(code || 0));
}

function python(file, args = []) {
  const child = spawn("python3", [file, ...args], { stdio: "inherit", cwd: ROOT });
  child.on("close", (code) => process.exit(code || 0));
}

/* ---------- inbox: the Telegram bridge as a background process ----------
 *
 * The state rule lives in lib/inbox.js, because `jarvis inbox`, doctor and
 * `jarvis connect --status` all report on the bridge and must agree about the
 * word "running". */
const inboxLib = require(path.join(ROOT, "lib", "inbox"));
const { PID_FILE: INBOX_PID, LOG_FILE: INBOX_LOG } = inboxLib;
const { status: inboxStatus, line: inboxLine } = inboxLib;

async function main() {
  switch (cmd) {
    case "start":
      return run(path.join(ROOT, "server.js"));

    case "setup":
      return run(path.join(ROOT, "scripts", "setup.js"));

    case "collect":
      return python(path.join(ROOT, "scripts", "collect.py"), rest);

    case "voice": {
      const child = spawn("bash", [path.join(ROOT, "scripts", "voice.sh"), ...rest], {
        stdio: "inherit", cwd: ROOT,
      });
      child.on("close", (code) => process.exit(code || 0));
      return;
    }

    case "ytdlp": {
      const child = spawn("bash", [path.join(ROOT, "scripts", "ytdlp.sh"), ...rest], {
        stdio: "inherit", cwd: ROOT,
      });
      child.on("close", (code) => process.exit(code || 0));
      return;
    }

    /* MCP servers are the one integration Jarvis inherits rather than owns.
     * The CLI has to make the state visible, because the failure when a server
     * is connected but not allowed is a local rejection that reads like an
     * outage. */
    case "mcp": {
      const cfg = load();
      const mcp = require(path.join(ROOT, "lib", "mcp"));
      const { save } = require(path.join(ROOT, "lib", "config"));
      const [sub, ...names] = rest;

      if (!sub || sub === "list") {
        const { servers, error } = await mcp.status(cfg);
        if (error) {
          // never render a failed lookup as "you have none"
          console.log(`\n  Could not read your MCP servers: ${error}\n`);
          return;
        }
        if (!servers.length) {
          console.log("\n  No MCP servers configured for the `claude` CLI.");
          console.log("  Add one with: claude mcp add <name> <url>\n");
          return;
        }
        console.log("");
        for (const s of servers) {
          const state = s.enabled ? "ON " : "off";
          const health = s.connected ? "" : `  (${s.status})`;
          console.log(`  ${state}  ${s.name.padEnd(26)} ${s.prefix}${health}`);
        }
        const off = servers.filter((s) => !s.enabled).length;
        if (off) {
          console.log(`\n  ${off} server(s) connected but not available to Jarvis.`);
          console.log(`  Turn one on:  jarvis mcp allow <name>`);
          console.log(`  Or all:       jarvis mcp allow all\n`);
        } else {
          console.log(`\n  All ${servers.length} available to Jarvis.\n`);
        }
        return;
      }

      if (sub === "allow" || sub === "deny") {
        if (!names.length) {
          console.error(`usage: jarvis mcp ${sub} <name> [name...]   (or "all")`);
          process.exit(1);
        }
        const { servers, error } = await mcp.discover();
        if (error && names[0] !== "all") {
          console.error(`  Could not read your MCP servers: ${error}`);
          process.exit(1);
        }
        if (names[0] === "all") {
          save({ chat: { mcp_servers: sub === "allow" ? "all" : [] } });
          console.log(sub === "allow"
            ? `  all MCP servers are now available to Jarvis`
            : `  no MCP servers are available to Jarvis`);
          return;
        }
        const current = mcp.enabledNames(cfg);
        // "all" is not a list, so turning one off has to expand it first
        let list = current === "all" ? servers.map((s) => s.name) : [...current];
        for (const n of names) {
          const hit = servers.find((s) => s.name.toLowerCase() === n.toLowerCase());
          if (!hit) {
            console.error(`  no such MCP server: ${n}`);
            console.error(`  known: ${servers.map((s) => s.name).join(", ") || "none"}`);
            process.exit(1);
          }
          const has = list.some((x) => String(x).toLowerCase() === hit.name.toLowerCase());
          if (sub === "allow" && !has) list.push(hit.name);
          if (sub === "deny") list = list.filter((x) => String(x).toLowerCase() !== hit.name.toLowerCase());
        }
        save({ chat: { mcp_servers: list } });
        console.log(`  ${sub === "allow" ? "allowed" : "denied"}: ${names.join(", ")}`);
        console.log(`  Jarvis can now use: ${list.length ? list.join(", ") : "no MCP servers"}`);
        console.log(`  Restart the server for it to take effect.`);
        return;
      }

      console.error("usage: jarvis mcp [list | allow <name> | deny <name>]");
      process.exit(1);
    }

    /* The guided version of docs/NOTIFY.md: pick a platform, follow its
     * clicks, paste the secret, and do not stop until a real message has
     * arrived. `notify` reports and tests what is already wired; this is what
     * gets it wired in the first place, for someone who has read nothing. */
    case "connect":
      return run(path.join(ROOT, "scripts", "connect.js"), rest);

    /* Chat delivery is the second thing here that leaves the machine, so the
     * CLI never sends by accident: no arguments only reads config and .env
     * and says what is set. `test` does send, one line per target, because a
     * webhook that exists is not a webhook that works. A target is a channel
     * name from notify.channels (what agents use) or a bare provider name. */
    case "notify": {
      const cfg = load(); // puts .env into process.env, same as every other command
      const notifyLib = require(path.join(ROOT, "lib", "notify"));
      const script = path.join(ROOT, "scripts", "notify.py");
      const [sub, only] = rest;
      const PROVIDERS = notifyLib.PROVIDERS;
      const chans = notifyLib.channels(cfg);
      const ready = Object.keys(PROVIDERS).filter((p) => PROVIDERS[p].every((k) => process.env[k]));

      if (!sub) {
        console.log("");
        const names = Object.keys(chans);
        if (names.length) {
          console.log("  CHANNELS (notify.channels, what agents name in notify: [...])");
          for (const n of names) {
            const r = notifyLib.resolve(cfg, n);
            console.log(`  ${r.ok ? "ON " : "off"}  ${n.padEnd(12)} ${(r.provider || "?").padEnd(9)} ${r.ok ? "configured" : r.reason}`);
          }
          console.log("");
        }
        console.log("  PROVIDERS (keys in .env)");
        for (const [p, keys] of Object.entries(PROVIDERS)) {
          const missing = keys.filter((k) => !process.env[k]);
          console.log(`  ${missing.length ? "off" : "ON "}  ${p.padEnd(10)} ${missing.length ? "set " + missing.join(", ") : "configured"}`);
        }
        const first = names.find((n) => notifyLib.resolve(cfg, n).ok) || ready[0];
        console.log(first
          ? `\n  Nothing was sent. Try one:  jarvis notify test ${first}\n`
          : `\n  None configured. Add keys to .env (see .env.example), then:  jarvis notify test\n`);
        if (!names.length && ready.length)
          console.log(`  Agents deliver to named channels: add {"notify": {"channels": {"phone": {"provider": "${ready[0]}"}}}} to config.json\n`);
        return;
      }

      if (sub === "test") {
        // a channel name wins over a provider name, so a channel called
        // "discord" tests that channel's env override rather than the default
        let targets;
        if (only && chans[only]) targets = [{ label: only, channel: only }];
        else if (only && PROVIDERS[only]) targets = [{ label: only, provider: only }];
        else if (only) {
          console.error(`  no such channel or provider: ${only}`);
          console.error(`  channels: ${Object.keys(chans).join(", ") || "none"}`);
          console.error(`  providers: ${Object.keys(PROVIDERS).join(", ")}`);
          process.exit(1);
        } else {
          const okChans = Object.keys(chans).filter((n) => notifyLib.resolve(cfg, n).ok);
          targets = okChans.length
            ? okChans.map((n) => ({ label: n, channel: n }))
            : ready.map((p) => ({ label: p, provider: p }));
        }
        if (!targets.length) {
          console.log("  nothing to test: no channel or provider has its keys in .env");
          return;
        }
        let bad = 0;
        for (const t of targets) {
          let provider = t.provider;
          let env = process.env;
          if (t.channel) {
            const r = notifyLib.resolve(cfg, t.channel);
            if (!r.ok) { bad++; console.log(`  FAIL  ${t.label.padEnd(10)} ${r.reason}`); continue; }
            provider = r.provider;
            env = notifyLib.envFor(r);
          }
          try {
            execFileSync("python3", [script, "--via", provider, "--test"], {
              cwd: ROOT, encoding: "utf8", stdio: ["ignore", "pipe", "pipe"], env, timeout: 30000,
            });
            console.log(`  ok    ${t.label.padEnd(10)} ${t.channel ? `(${provider})` : ""}`);
          } catch (e) {
            bad++;
            // the script prints "FAIL <provider>: <reason>" then a summary
            // line; the reason is the useful part
            const lines = String((e.stderr || "") + (e.stdout || "")).trim().split("\n");
            const out = (lines.find((l) => l.startsWith(`FAIL ${provider}:`)) || lines.pop() || String(e.message || "")).replace(`FAIL ${provider}: `, "");
            console.log(`  FAIL  ${t.label.padEnd(10)} ${out}`);
          }
        }
        process.exit(bad ? 1 : 0);
      }

      /* Telegram is the one provider where the second secret cannot be copied
       * from a settings page: the chat id only exists after someone messages
       * the bot, and the way to read it is a JSON dump most people have never
       * seen. Do that lookup here, with the token already in .env, and print
       * only the chats and their ids. Nothing is sent. */
      if (sub === "telegram-id") {
        const token = process.env.TELEGRAM_BOT_TOKEN;
        if (!token) {
          console.error("  set TELEGRAM_BOT_TOKEN in .env first (from @BotFather), then message your bot once");
          process.exit(1);
        }
        const r = await notifyLib.telegramChats(token);
        if (!r.ok) {
          console.error(`  telegram refused it: ${r.error}`);
          console.error("  a 401 means the token is wrong or was revoked in @BotFather");
          process.exit(1);
        }
        if (!r.chats.length) {
          console.log("\n  no chats yet. Open your bot in Telegram, send it any message, then run this again.");
          console.log("  (for a group: add the bot to the group and post a message there; Telegram keeps updates for 24 hours)\n");
          process.exit(1);
        }
        console.log("\n  chats that have messaged this bot:\n");
        for (const c of r.chats)
          console.log(`  ${c.id.padEnd(16)} ${(c.type || "").padEnd(11)} ${c.who}`);
        console.log(`\n  put one in .env:  TELEGRAM_CHAT_ID=${r.chats[0].id}\n  then prove it:    jarvis notify test telegram\n`);
        return;
      }

      console.error("usage: jarvis notify [test [channel-or-provider] | telegram-id]");
      process.exit(1);
    }

    /* The reverse of notify: messages from the operator's phone, forwarded to
     * the local /api/chat by scripts/inbox.py. The bridge only ever makes
     * outbound requests (a Telegram long poll and a loopback POST), so the
     * server stays on 127.0.0.1 and nothing new listens. What it forwards is
     * gated by chat id, and that list is the whole security of the feature;
     * `jarvis inbox` prints it so it can be checked at a glance. */
    case "inbox": {
      const cfg = load();
      const script = path.join(ROOT, "scripts", "inbox.py");
      const schedule = require(path.join(ROOT, "lib", "schedule"));
      const [sub, flag] = rest;
      const s = inboxStatus();
      const refuse = () => {
        console.error(`\n  inbox is not configured: set ${s.missing.join(" and ")} in .env.`);
        console.error(`  It is the same bot notify uses: docs/NOTIFY.md, the Telegram section.`);
        console.error(`  The chat id is found, never guessed:  jarvis notify telegram-id\n`);
        process.exit(1);
      };

      if (!sub || sub === "status") {
        console.log(`\n  INBOX              ${inboxLine(s)}`);
        if (s.configured) {
          console.log(`    allowed chats      ${s.allowed.length}: ${s.allowed.join(", ")}   (TELEGRAM_CHAT_ID + TELEGRAM_ALLOWED_CHAT_IDS)`);
          console.log(`    last poll          ${s.lastPoll ? new Date(s.lastPoll).toLocaleString() : "never"}`);
          console.log(`    keep-alive         ${(await schedule.serviceInstalled("inbox")) ? "installed" : "not installed   (jarvis inbox install)"}`);
          console.log(`    log                ${path.relative(ROOT, INBOX_LOG)}`);
          console.log(s.running ? `\n  stop it:  jarvis inbox stop\n` : `\n  start it: jarvis inbox start\n`);
        } else {
          console.log("");
        }
        return;
      }

      if (sub === "start") {
        if (!s.configured) refuse();
        if (s.running) {
          console.log(`  already running (pid ${s.pid}). jarvis inbox stop first.`);
          return;
        }
        // getMe once, here, so the operator sees the bot's name and a bad
        // token fails in the terminal rather than in a log nobody is reading
        const token = process.env.TELEGRAM_BOT_TOKEN;
        const base = (process.env.TELEGRAM_API_BASE || "https://api.telegram.org").replace(/\/$/, "");
        let bot = "";
        try {
          const r = await fetch(`${base}/bot${token}/getMe`, { signal: AbortSignal.timeout(15000) });
          const body = await r.json();
          if (!body.ok) throw new Error(body.description || `HTTP ${r.status}`);
          bot = body.result.username || "";
        } catch (e) {
          console.error(`  telegram refused it: ${String(e.message || e).replace(token, "<token>")}`);
          console.error("  a 401 means the token is wrong or was revoked in @BotFather");
          process.exit(1);
        }
        fs.mkdirSync(path.dirname(INBOX_LOG), { recursive: true });
        // the script writes its own log; this file only catches a crash
        const out = fs.openSync(path.join(ROOT, "data", "inbox.out.log"), "a");
        const child = spawn("python3", [script], {
          cwd: ROOT, detached: true, stdio: ["ignore", out, out], env: process.env,
        });
        child.unref();
        fs.writeFileSync(INBOX_PID, String(child.pid) + "\n");
        console.log(`  polling as @${bot || "?"} for chat ${s.allowed.join(", ")} (pid ${child.pid})`);
        console.log(`  messages from any other chat are ignored. log: ${path.relative(ROOT, INBOX_LOG)}`);
        console.log(`  stop it: jarvis inbox stop`);
        return;
      }

      /* The foreground form the keep-alive job runs: same script, this
       * process stays attached so launchd can restart it. Not in help; a
       * person wants `start`. */
      if (sub === "poll") {
        if (!s.configured) refuse();
        if (s.running) { console.error(`  already running (pid ${s.pid})`); process.exit(1); }
        const child = spawn("python3", [script], { cwd: ROOT, stdio: "inherit", env: process.env });
        fs.mkdirSync(path.dirname(INBOX_PID), { recursive: true });
        fs.writeFileSync(INBOX_PID, String(child.pid) + "\n");
        const stop = () => { try { child.kill("SIGTERM"); } catch {} };
        process.on("SIGTERM", stop);
        process.on("SIGINT", stop);
        child.on("close", (code) => { try { fs.unlinkSync(INBOX_PID); } catch {} process.exit(code || 0); });
        return;
      }

      if (sub === "stop") {
        if (!s.pid) { console.log("  not running"); return; }
        if (s.running) {
          try { process.kill(s.pid, "SIGTERM"); } catch {}
          console.log(`  stopped (pid ${s.pid})`);
        } else {
          console.log(`  not running (stale pid ${s.pid} removed)`);
        }
        try { fs.unlinkSync(INBOX_PID); } catch {}
        if (await schedule.serviceInstalled("inbox"))
          console.log("  the keep-alive job is installed and will start it again; jarvis inbox uninstall to stop that");
        return;
      }

      if (sub === "install") {
        if (!s.configured) refuse();
        const preview = schedule.servicePreview(cfg, "inbox", ["inbox", "poll"]);
        if (flag === "--show" || flag === "--dry-run") {
          console.log(`\n  would write (${preview.platform})${preview.file ? ": " + preview.file : ""}\n`);
          console.log(preview.text);
          return;
        }
        const p = await schedule.installService(cfg, "inbox", ["inbox", "poll"]);
        console.log(`  installed on ${p.platform}${p.file ? `: ${p.file}` : ""}`);
        console.log(`  it starts now and after every reboot. jarvis inbox uninstall removes it.`);
        return;
      }

      if (sub === "uninstall") {
        const gone = await schedule.uninstallService(cfg, "inbox");
        console.log(gone ? "  keep-alive removed" : "  nothing installed");
        if (s.running) console.log(`  the poller itself is still running (pid ${s.pid}); jarvis inbox stop`);
        return;
      }

      console.error("usage: jarvis inbox [status | start | stop | install [--show] | uninstall]");
      process.exit(1);
    }

    case "index":
      return python(path.join(ROOT, "scripts", "index.py"), rest);

    /* The same file chat's "remember that" writes, from the terminal. Goes
     * through lib/memory so the budget and the section heuristic are the
     * ones the server applies; there is one way to write this file. */
    case "memory": {
      const cfg = load();
      const memory = require(path.join(ROOT, "lib", "memory"));
      const [sub, ...words] = rest;
      if (!sub) {
        const r = memory.read(cfg);
        console.log(r.text ? "\n" + r.text.trim() + "\n" : "\n  memory is empty\n");
        console.log(`  ${r.chars} / ${r.budget} chars   ${r.file.replace(process.env.HOME || "~", "~")}`);
        console.log(`  add one:     jarvis memory add "<text>"`);
        console.log(`  drop lines:  jarvis memory forget <words>\n`);
        return;
      }
      if (sub === "add") {
        const text = words.join(" ").trim();
        if (!text) { console.error('usage: jarvis memory add "<text>"'); process.exit(1); }
        const r = memory.append(cfg, { text });
        if (!r.ok) { console.error(`  not remembered: ${r.reason}`); process.exit(1); }
        console.log(`  remembered under ${r.section}: ${r.line}`);
        console.log(`  ${r.chars} / ${r.budget} chars`);
        return;
      }
      if (sub === "forget") {
        const needle = words.join(" ").trim();
        if (!needle) { console.error("usage: jarvis memory forget <words>"); process.exit(1); }
        const r = memory.forget(cfg, needle);
        if (!r.count) { console.log(`  nothing in memory matches "${needle}"`); return; }
        console.log(`  forgot ${r.count} line(s):`);
        r.removed.forEach((l) => console.log(`    ${l}`));
        return;
      }
      console.error('usage: jarvis memory [add "<text>" | forget <words>]');
      process.exit(1);
    }

    /* Read only. Opening and closing go through scripts/experiments.py so
     * the cap and the append-only rule live in one place. */
    case "experiments": {
      const cfg = load();
      const ex = require(path.join(ROOT, "lib", "experiments"));

      /* Writing goes through the python script, which owns the ledger and its
       * rules. Forwarding rather than reimplementing keeps one writer, and
       * stops `jarvis experiments add ...` from printing the read-only
       * summary and exiting 0 as though it had opened something. */
      if (rest.length) {
        const sub = rest[0];
        if (!["add", "close", "due", "list", "check"].includes(sub)) {
          console.error(`unknown: jarvis experiments ${sub}`);
          console.error(`try: jarvis experiments            the summary`);
          console.error(`     jarvis experiments add ...    open one (--hypothesis --metric --target --deadline)`);
          console.error(`     jarvis experiments close <id> --result "..." --verdict confirmed|refuted|unmeasured`);
          process.exitCode = 1;
          return;
        }
        python(path.join(ROOT, "scripts", "experiments.py"), rest);
        return;
      }

      const all = ex.read(cfg);
      const s = ex.summary(cfg);
      console.log(`\n  EXPERIMENTS        ${s.head}   ${path.relative(ROOT, ex.file(cfg))}`);
      const show = (list) => list.forEach((e) => {
        console.log(`    ${e.id.padEnd(34)} ${e.status.padEnd(7)} ${ex.daysWord(e)}${e.status === "closed" ? `  ${e.verdict}` : ""}`);
        console.log(`        ${e.hypothesis}`);
        console.log(`        metric: ${e.metric}   target: ${e.target}   deadline: ${e.deadline || "none"}`);
        if (e.result) console.log(`        result: ${e.result}`);
      });
      const opened = all.filter((e) => e.status === "open");
      const closed = all.filter((e) => e.status === "closed");
      console.log(`\n  OPEN (${opened.length} of ${s.maxOpen})`);
      opened.length ? show(opened) : console.log("    (none)");
      console.log(`\n  CLOSED (${closed.length})`);
      closed.length ? show(closed) : console.log("    (none)");
      console.log(`\n  open one:    python3 scripts/experiments.py add --hypothesis "..." --metric "..." --target "..." --deadline YYYY-MM-DD`);
      console.log(`  close one:   python3 scripts/experiments.py close <id> --result "..." --verdict confirmed|refuted|unmeasured\n`);
      return;
    }

    case "transcript":
      if (!rest.length) {
        console.error("usage: jarvis transcript <youtube-url-or-id> [--out FILE]");
        process.exit(1);
      }
      return python(path.join(ROOT, "scripts", "transcript.py"), rest);

    case "agent": {
      const cfg = load();
      const agents = require(path.join(ROOT, "lib", "agents"));
      const name = rest[0];
      if (!name) {
        console.error("usage: jarvis agent <name>");
        process.exit(1);
      }
      // Exit with the run's code. This used to return 0 whatever happened,
      // so launchd, cron and a person reading `$?` all saw success on a run
      // whose log said "Connection closed". A skip is 0 because the config
      // is what needs fixing, and the reason is printed so it is not silent.
      const res = await agents.runWithRetry(cfg, name, { onLog: (l) => console.log(l) });
      if (res.skipped) { console.log(`skipped: missing config for ${res.missing.join(", ")}`); process.exit(0); }
      if (res.code !== 0) console.error(`${name}: exit ${res.code}${res.error ? ` (${res.error})` : ""}${res.retried ? ", after one retry" : ""}`);
      process.exit(res.code || 0);
    }

    case "agents": {
      const cfg = load();
      const agents = require(path.join(ROOT, "lib", "agents"));
      const schedule = require(path.join(ROOT, "lib", "schedule"));
      const all = agents.list(cfg);
      const sub = rest[0];

      if (sub === "install") {
        const { platform, installed } = await schedule.install(cfg, all);
        if (!installed.length) {
          console.log("nothing to install - no enabled agents have a schedule");
          console.log(`enable some in config.json under agents.enabled`);
          return;
        }
        console.log(`installed on ${platform === "darwin" ? "launchd" : "cron"}:`);
        installed.forEach((i) => console.log(`  ${i}`));
        const advice = sleepAdvice();
        if (advice.warn) {
          console.log(`\n  HEADS UP: these times assume the machine is awake.`);
          advice.lines.forEach((l) => console.log(`  ${l}`));
        }
        return;
      }
      if (sub === "check") {
        let bad = 0;
        for (const r of agents.check(cfg)) {
          const tag = r.problems.length ? "FAIL" : "ok  ";
          console.log(`  ${tag} ${r.name.padEnd(15)} ${r.enabled ? "" : "(disabled)"}`);
          r.problems.forEach((p2) => { bad++; console.log(`         ! ${p2}`); });
          r.notes.forEach((n) => console.log(`         - ${n}`));
        }
        console.log(bad ? `\n  ${bad} problem(s)` : `\n  all agents check out`);
        process.exit(bad ? 1 : 0);
      }
      if (sub === "uninstall") {
        const { removed } = await schedule.uninstall(cfg, all);
        console.log(removed.length ? `removed: ${removed.join(", ")}` : "nothing installed");
        return;
      }

      const runsLib = require(path.join(ROOT, "lib", "runs"));
      for (const a of all) {
        const unmet = agents.unmetRequirements(a, cfg);
        const state = !a.enabled ? "off" : unmet.length ? `needs ${unmet.join(",")}` : "on";
        // the ledger, not the log's mtime: a restore from backup or a tail
        // of the log used to make every agent look freshly run
        const h = runsLib.health(cfg, a);
        const last = h.lastRun ? `${new Date(h.lastRun).toLocaleString()} ${h.lastExit === null ? "(open)" : `exit ${h.lastExit}`}` : "never run";
        const flag = a.enabled && h.state !== "ok" ? `  <- ${h.state.toUpperCase()}${h.detail ? `: ${h.detail}` : ""}` : "";
        console.log(`  ${a.name.padEnd(15)} ${String(a.schedule || "on demand").padEnd(14)} ${state.padEnd(16)} ${last}${flag}`);
      }
      console.log(`\n  run one now:  jarvis agent <name>`);
      console.log(`  schedule all: jarvis agents install`);
      return;
    }

    case "doctor": {
      const cfg = load();
      const tts = require(path.join(ROOT, "lib", "tts"));
      const stt = require(path.join(ROOT, "lib", "stt"));
      const voice = await tts.status(cfg);
      const mic = await stt.status(cfg);
      const ok = (b) => (b ? "yes" : "no");
      const shell = require(path.join(ROOT, "lib", "shell"));

      /* On a fresh clone every alarm below is true and none of it is the
       * person's fault: nothing is scheduled because they have not set up
       * yet. Lead with the three steps instead of making them read ninety
       * lines of red to find `run jarvis setup` on line eleven. */
      if (!cfg.configured) {
        console.log(`
  NOT SET UP YET

    1. jarvis setup            name, channel, and which agents to run
    2. npm start               the HUD on http://localhost:4747
    3. jarvis agents install   only when you want them on a schedule

  The rest of this report is what is on the machine right now. Anything
  about schedules is expected to be empty until step 3.`);
      }

      /* Platform first. Everything below behaves differently per OS, and
       * "why is scheduling doing nothing" is answered here rather than after
       * an hour of reading source. */
      const [shBin] = shell.shellFor("true");
      const plat = { darwin: "macOS", win32: "Windows", linux: "Linux" }[process.platform]
        || process.platform;
      console.log(`\n  PLATFORM`);
      console.log(`    os                 ${plat} (${process.arch})`);
      const nodeMajor = parseInt(process.versions.node.split(".")[0], 10);
      console.log(`    node               ${process.version}${nodeMajor < MIN_NODE ? `   <- too old, needs ${MIN_NODE}+` : ""}`);
      console.log(`    shell              ${shBin}`);
      console.log(`    scheduler          ${
        process.platform === "darwin" ? "launchd"
        : process.platform === "win32" ? "Task Scheduler (schtasks)"
        : "crontab"}`);
      if (process.platform === "win32") {
        console.log(`    note               .sh installers (yt-dlp, Kokoro voice) need`);
        console.log(`                       Git Bash or WSL. Everything else is native.`);
      }

      console.log(`\n  CONFIG`);
      console.log(`    config.json        ${ok(cfg.configured)}${cfg.configured ? "" : "   <- run 'jarvis setup'"}`);
      console.log(`    owner              ${cfg.profile.owner || "(unset)"}`);
      console.log(`    youtube            ${cfg.profile.channels.youtube || "(unset)"}`);
      console.log(`    persona override   ${ok(fs.existsSync(path.join(ROOT, "PERSONA.md")))}`);

      const brain = require(path.join(ROOT, "lib", "brain"));
      const brainStatus = await brain.status(cfg);
      console.log(`\n  BRAIN (${cfg.brain.chain.join(" -> ")})`);
      console.log(`    claude code        ${ok(brainStatus.providers["claude-code"])}`);
      console.log(`    openai-compatible  ${ok(brainStatus.providers.openai)}   ${cfg.brain.openai.base_url}`);
      console.log(`    active             ${brainStatus.active || "NONE - chat will not work"}`);
      console.log(`    model              ${cfg.chat.model || "(the CLI default)"}`);

      /* `claude` being installed is not `claude` being able to answer. An
       * expired login, an exhausted usage cap and a model the plan does not
       * include all leave the binary in place and every version check happy,
       * while chat returns nothing. Spend one real turn. */
      if (brainStatus.active) {
        const answer = await brain.probe(cfg).catch((e) => ({ ok: false, kind: "probe", message: String(e) }));
        if (answer.ok) {
          console.log(`    answers            ok   (${answer.ms}ms)`);
        } else {
          console.log(`    answers            FAILED   ${answer.label || ""}`);
          if (answer.message) console.log(`                       ${answer.message}`);
          if (answer.hint) console.log(`                       -> ${answer.hint}`);
        }
      }

      /* A path that does not exist is not the same as no path configured. The
       * first is a typo the operator can fix; the second is a supported state.
       * Agents were told to read the missing file either way. */
      const pbLib = require(path.join(ROOT, "lib", "playbook"));
      const pbFiles = pbLib.playbookFiles(cfg);
      const configured = ((cfg.knowledge || {}).brain_files || []).length > 0;
      console.log(`\n  PLAYBOOK (${configured ? "knowledge.brain_files" : "local playbook/"})`);
      for (const f of pbFiles) {
        const there = fs.existsSync(f);
        const shown = f.replace(process.env.HOME || "~", "~");
        console.log(`    ${there ? "ok  " : "MISSING"}           ${shown}${
          there ? "" : configured ? "   <- configured but not on disk" : "   (will be created on the first rule)"}`);
      }

      console.log(`\n  TOOLS`);
      console.log(`    yt-dlp             ${ytdlpStatus()}`);
      console.log(`    ffmpeg             ${ok(mic.ffmpeg)}   (needed for local whisper)`);

      console.log(`\n  VOICE OUT (first available wins: ${cfg.voice.chain.join(" -> ")})`);
      for (const [k, v] of Object.entries(voice)) console.log(`    ${k.padEnd(18)} ${ok(v)}`);

      console.log(`\n  VOICE IN (${cfg.stt.chain.join(" -> ")})`);
      // Everything below answers "could this transcribe". This one answers
      // "is there anything to transcribe", which is what actually bites: a
      // Mac Studio has no built-in mic, so the rest can all be ready while
      // the browser fails with NotFoundError.
      console.log(`    microphone         ${
        mic.input === null ? "unknown" :
        mic.input ? "yes" : "NONE - no audio input device on this machine"}`);
      console.log(`    local whisper      ${ok(mic.local)}`);
      console.log(`    openai whisper     ${ok(mic.openai)}`);
      console.log(`    browser fallback   yes   (chrome only, audio leaves this machine)`);

      console.log(`\n  SERVER`);
      const loopback = ["127.0.0.1", "localhost", "::1"].includes(cfg.server.host);
      console.log(`    bind               ${cfg.server.host}:${cfg.server.port}`);
      console.log(`    token              ${cfg.server.token ? "set" : "not set"}`);
      if (!loopback && !cfg.server.token)
        console.log(`    WARNING            exposed without a token - the server will refuse to start`);

      /* A connected-but-not-allowed server fails as a local rejection, which
       * reads like the service being down. Showing both states is the
       * difference between a five second fix and debugging the wrong layer. */
      const mcpLib = require(path.join(ROOT, "lib", "mcp"));
      const { servers, error: mcpErr } =
        await mcpLib.status(cfg).catch((e) => ({ servers: [], error: e.message }));
      if (mcpErr) {
        console.log(`\n  MCP SERVERS        could not check: ${mcpErr}`);
      } else if (servers.length) {
        const on = servers.filter((s) => s.enabled);
        console.log(`\n  MCP SERVERS        ${on.length} of ${servers.length} available to Jarvis`);
        for (const s of servers) {
          const why = !s.connected ? `   (${s.status})` : "";
          console.log(`    ${s.name.padEnd(24)} ${s.enabled ? "yes" : "no "}${why}`);
        }
        if (on.length < servers.length)
          console.log(`    fix                jarvis mcp allow <name>`);
      } else {
        console.log(`\n  MCP SERVERS        none configured for the claude CLI`);
      }

      /* Chat delivery. Lists what is wired, never sends: doctor gets run in
       * sanity checks and a ping per run is how a channel gets muted. The
       * real exercise is one command away and named here. */
      {
        const notifyLib = require(path.join(ROOT, "lib", "notify"));
        const chans = notifyLib.channels(cfg);
        const names = Object.keys(chans);
        const agentsLib = require(path.join(ROOT, "lib", "agents"));
        const users = agentsLib.list(cfg).filter((a) => (a.notify || []).length);
        if (!names.length) {
          console.log(`\n  NOTIFY             no channels (notify.channels in config.json; off by default)`);
          for (const a of users)
            console.log(`    ${a.name.padEnd(18)} names ${a.notify.join(", ")} but no channel is defined`);
        } else {
          const okN = names.filter((n) => notifyLib.resolve(cfg, n).ok).length;
          console.log(`\n  NOTIFY             ${okN} of ${names.length} channel(s) configured`);
          for (const n of names) {
            const r = notifyLib.resolve(cfg, n);
            const envs = (r.slots || []).map((s) => `${s.from}=${process.env[s.from] ? "yes" : "no"}`).join(" ");
            const who = users.filter((a) => a.notify.includes(n)).map((a) => a.name);
            console.log(`    ${n.padEnd(18)} ${(r.provider || "?").padEnd(9)} ${envs || r.reason}${who.length ? `   <- ${who.join(", ")}` : ""}`);
            console.log(`    ${"".padEnd(18)} test: jarvis notify test ${n}`);
          }
          for (const a of users)
            for (const n of a.notify)
              if (!chans[n]) console.log(`    ${a.name.padEnd(18)} names channel "${n}" which does not exist`);
        }
      }

      /* The phone bridge. "running" is a live pid AND a recent poll: a
       * process can sit in a wedged socket for hours with its pid file
       * intact, which is exactly the state that reads as fine everywhere
       * else. */
      {
        const s = inboxStatus();
        console.log(`\n  INBOX              ${inboxLine(s)}`);
        if (s.configured)
          console.log(`    allowed chats      ${s.allowed.length} (${s.allowed.join(", ")}); anything else is ignored`);
      }

      /* Memory. Every number here is read from the files, not the config:
       * chat_log can be on with nothing ever logged, and a session id can be
       * present and days old, which is the one that explains "why does it
       * still think we were talking about last Tuesday". */
      {
        const memory = require(path.join(ROOT, "lib", "memory"));
        const { chatCwd } = require(path.join(ROOT, "lib", "config"));
        const mf = memory.files(cfg);
        const mem = memory.read(cfg);
        const there = fs.existsSync(mf.memory);
        const rel = (f) => path.relative(ROOT, f);
        console.log(`\n  MEMORY`);
        console.log(`    ${rel(mf.memory).padEnd(18)} ${there ? `yes   ${mem.lines.length} line(s), ${mem.chars} / ${mem.budget} chars` : "no    (say \"remember that ...\" in chat, or jarvis memory add)"}`);
        const { rows, days } = memory.decisions(cfg);
        console.log(`    decisions          ${rows.length} in the last ${days} day(s)${fs.existsSync(mf.decisions) ? "" : "   (no decisions.jsonl yet)"}`);
        const logOn = memory.settings(cfg).chatLog;
        let logSize = null;
        try { logSize = fs.statSync(mf.chatLog).size; } catch {}
        console.log(`    chat log           ${logOn ? "on " : "off"}   ${logSize === null ? "no file yet" : `${rel(mf.chatLog)} ${(logSize / 1024).toFixed(1)} KB`}`);
        const s = memory.getSession(cfg);
        if (s.sessionId) {
          const ageMs = s.started ? Date.now() - new Date(s.started).getTime() : null;
          const age = ageMs === null ? "age unknown" : ageMs < 3600000 ? `${Math.round(ageMs / 60000)} min old` : ageMs < 86400000 ? `${(ageMs / 3600000).toFixed(1)} h old` : `${(ageMs / 86400000).toFixed(1)} days old`;
          console.log(`    session            ${s.sessionId.slice(0, 8)}...  ${s.turns || 0} turn(s), ${age}`);
        } else {
          console.log(`    session            none   (the next chat starts a fresh one)`);
        }
        console.log(`    chat cwd           ${chatCwd(cfg).replace(process.env.HOME || "~", "~")}${cfg.chat.cwd ? "" : "   (repo root, same as the agents)"}`);
      }

      /* Experiments. Read from the ledger, not the config: the count that
       * matters is how many hypotheses are past their deadline with no
       * verdict, which is the review agent skipping its own homework. */
      {
        const ex = require(path.join(ROOT, "lib", "experiments"));
        const s = ex.summary(cfg);
        console.log(`\n  EXPERIMENTS`);
        console.log(`    ledger             ${s.open} open, ${s.overdue} overdue, ${s.closed} closed (cap ${s.maxOpen})${fs.existsSync(ex.file(cfg)) ? "" : "   (no decisions.jsonl yet; the review agent opens the first one)"}`);
        for (const e of ex.due(cfg)) console.log(`    OVERDUE            ${e.id}  ${ex.daysWord(e)}`);
      }

      /* Recurring scraper cost is easy to stop noticing, which is how a few
       * cents a day becomes a line item nobody remembers agreeing to. The
       * social agent appends one line per run; this just adds them up. */
      try {
        const spendFile = path.join(cfg.paths.data, "spend.log");
        const lines = fs.readFileSync(spendFile, "utf8").trim().split("\n").filter(Boolean);
        const recent = lines.slice(-30);
        const units = recent
          .map((l) => parseFloat((l.match(/([0-9]*\.?[0-9]+)\s*(?:cu|compute)/i) || [])[1]))
          .filter((n) => !isNaN(n));
        const total = units.reduce((a, b) => a + b, 0);
        console.log(`\n  SCRAPER SPEND      ${recent.length} run(s) logged` +
          (units.length ? `, ${total.toFixed(3)} compute units over the last ${units.length}` : ""));
        if (recent.length) console.log(`    latest             ${recent[recent.length - 1].trim().slice(0, 70)}`);
      } catch {
        // no log yet: the social agent has not run, or is not enabled
      }

      // Two different reasons an agent misses its time, and they need
      // different fixes. The clock one wins the headline because it is the one
      // that reads as "fine" everywhere else.
      const adv = sleepAdvice();
      const tz = timezoneAdvice(cfg);

      /* Then the part that would have caught the twelve silent days: is each
       * job actually loaded, does its plist point at a node that exists, and
       * did it run when the schedule said. Read from the ledger and from
       * launchctl, never from the config, which only says what should happen. */
      const agents = require(path.join(ROOT, "lib", "agents"));
      const runsLib = require(path.join(ROOT, "lib", "runs"));
      const scheduled = agents.list(cfg).filter((a) => a.enabled && a.schedule);
      const rows = runsLib.all(cfg, scheduled);
      const nLoaded = rows.filter((r) => r.loaded).length;
      const nOverdue = rows.filter((r) => r.overdue).length;
      const nBad = rows.filter((r) => r.state !== "ok").length;
      // nothing loaded beats every other headline: a timezone offset seen in
      // old logs is moot while no job can fire at all. On a clone that has
      // never been set up, though, nothing being scheduled is the expected
      // state rather than a fault, and saying so in red teaches people to
      // ignore the line that matters later.
      const state = scheduled.length && nLoaded === 0
          ? (cfg.configured ? "NOTHING IS SCHEDULED" : "not scheduled yet (jarvis agents install)")
        : tz.confirmed ? "AGENTS ARE RUNNING AT THE WRONG TIME"
        : nBad ? `${nBad} AGENT(S) NEED ATTENTION`
        : tz.warn ? "CLOCK MAY BE WRONG"
        : adv.warn ? "AGENTS WILL RUN LATE" : "ok";
      console.log(`\n  SCHEDULE           ${state}`);
      const when = (ms) => ms ? new Date(ms).toLocaleString("sv-SE", { dateStyle: "short", timeStyle: "short" }) : "never";
      for (const r of rows) {
        const a = scheduled.find((x) => x.name === r.agent);
        const exit = r.lastExit === null ? (r.lastRun ? "open" : "") : `exit ${r.lastExit}`;
        console.log(`    ${r.agent.padEnd(11)} ${String(a.schedule).padEnd(13)} loaded ${r.loaded ? "yes" : "no "}  last ${when(r.lastRun).padEnd(16)} ${exit.padEnd(8)} expected ${when(r.expectedAt).padEnd(16)} ${r.state.toUpperCase()}`);
        if (r.state !== "ok" && r.detail) console.log(`    ${"".padEnd(11)} ${r.detail}`);
      }
      if (scheduled.length) {
        console.log(`    ${nLoaded} of ${scheduled.length} scheduled agents loaded; ${nOverdue} overdue`);
        if (nLoaded < scheduled.length) console.log(`    fix                jarvis agents install`);
      } else {
        console.log(`    no enabled agent has a schedule`);
      }
      // The watchdog is itself a scheduled agent, so its own silence has to
      // be visible here or a dead watchdog looks like a quiet one.
      {
        const chk = readJsonFile(path.join(cfg.paths.data, "runs-check.json"));
        if (!chk || !chk.checked_at) {
          console.log(`    watchdog           never checked (scripts/runs.py --check has not run; jarvis agent watchdog)`);
        } else {
          const ageMs = Date.now() - new Date(chk.checked_at).getTime();
          const age = ageMs < 3600000 ? `${Math.round(ageMs / 60000)} min ago` : ageMs < 86400000 ? `${(ageMs / 3600000).toFixed(1)} h ago` : `${(ageMs / 86400000).toFixed(1)} days ago`;
          const n = (chk.problems || []).length;
          console.log(`    watchdog           last checked ${age}, ${n} problem(s)${ageMs > 36 * 3600000 ? "   <- stale, the watchdog itself is not running" : ""}`);
        }
      }
      if (tz.lines.length || adv.lines.length) console.log(`    --`);
      tz.lines.forEach((l) => console.log(`    ${l}`));
      if (tz.warn && adv.lines.length) console.log(`    --`);
      adv.lines.forEach((l) => console.log(`    ${l}`));

      const enabled = agents.list(cfg).filter((a) => a.enabled);
      console.log(`\n  AGENTS             ${enabled.length} enabled: ${enabled.map((a) => a.name).join(", ") || "none"}\n`);
      return;
    }

    case "--help":
    case "-h":
    case "help":
      console.log(fs.readFileSync(__filename, "utf8").split("*/")[0].replace(/^#![^\n]*\n/, "").replace(/\/\* ?/g, "").replace(/^ \* ?/gm, ""));
      return;

    default:
      console.error(`unknown command: ${cmd}\ntry: jarvis help`);
      process.exit(1);
  }
}

main().catch((e) => {
  console.error(e.message || e);
  process.exit(1);
});
