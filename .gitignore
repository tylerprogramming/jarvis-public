.DS_Store
node_modules/

# Your setup and your secrets. Never commit these.
config.json
.env
PERSONA.md

# What the agents have concluded about you. Yours, not the software's.
playbook.md

# Everything Jarvis generates about you.
data/*.json
data/*.log
data/.kokoro-mode
!data/*.example.json
!data/README.md
# Output folders: the folder's own label ships, the contents never do.
reports/*
drafts/*
journal/*
!reports/README.md
!drafts/README.md
!journal/CLAUDE.md
!journal/*.example.md

# Private integrations you drop in. See plugins/collectors/README.md.
plugins/collectors/*
!plugins/collectors/README.md
!plugins/collectors/*.example.py

# scratch research pulls - competitor video ids, view counts, channel names
.study-lane-*.txt

# scratch design comparisons - they carry whatever data was on screen
public/_*.html

__pycache__/
*.pyc

.venv-kokoro/
models/

bin/yt-dlp
