# Copy to .env and fill in what you need. Everything here is optional -
# Jarvis runs, talks, and listens with none of it.
#
# .env is gitignored. Never put keys in config.json.

# --- voice out -------------------------------------------------------------
# Premium voice. Without it Jarvis falls back to Kokoro, Piper, then your
# system voice, all free. See docs/CONFIGURATION.md.
# ELEVENLABS_API_KEY=

# Only if your local Kokoro / OpenAI-speech server requires auth.
# KOKORO_API_KEY=

# --- the brain -------------------------------------------------------------
# Jarvis uses Claude Code when it is installed - it needs no key here and is
# the better option. Set this only to run the command bar on an OpenAI model
# instead. Not needed at all if brain.openai.base_url points at a local server
# (Ollama, LM Studio, llama.cpp). The same key is used for hosted Whisper.
# OPENAI_API_KEY=

# For a non-OpenAI hosted endpoint (OpenRouter, Groq, Together) that wants its
# own key rather than OPENAI_API_KEY.
# BRAIN_API_KEY=

# --- voice in --------------------------------------------------------------
# Hosted Whisper transcription also reads OPENAI_API_KEY above.

# Only if your local whisper server requires auth.
# WHISPER_API_KEY=

# --- server ----------------------------------------------------------------
# Required if you bind anywhere other than localhost. Generate one with:
#   openssl rand -hex 24
# Read docs/SECURITY.md first - /api/chat can write to your machine.
# JARVIS_TOKEN=

# JARVIS_HOST=127.0.0.1
# JARVIS_PORT=4747
